// ============================================================
// 2) MeterReading — การจดมิเตอร์
// ============================================================
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

// Committed as "postgresql" — this is production's provider (Supabase), and
// Vercel builds with NODE_ENV=production, where set-prisma-provider.mjs refuses
// to run against anything else. Committing the production value is what makes
// the local auto-switch correct: for a `file:` DATABASE_URL the script rewrites
// this line to "sqlite" in dev and back on deploy.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
  // directUrl — migration-only connection that bypasses the pooler.
  //
  // Supabase's Transaction pooler (port 6543, DATABASE_URL) is right for the
  // serverless runtime, but `prisma migrate` runs DDL inside a transaction and
  // PgBouncer in transaction mode does not guarantee that stays one
  // transaction, so migrations fail against it. directUrl points at the direct
  // endpoint (port 5432) for exactly that reason.
  //
  // SQLite has no pooler, so DIRECT_DATABASE_URL just mirrors DATABASE_URL
  // there. Prisma requires the variable to EXIST either way — omitting it is a
  // P1012 "Environment variable not found", not a provider error.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================================================
// Multi-Organization Foundation (Phase 1) — based on consultant blueprint
// These models are additive — they don't break existing business data.
// All organizationId fields are nullable to allow migration of legacy rows.
// ============================================================

/// Organization — top-level tenant boundary.
/// Separates per-org business data. Has nothing to do with OrganizationProfile
/// (which holds UI/policy customization like logo, colors, fiscal year).
model Organization {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "PILOT", "ABC", "HOSPITAL_A" — uppercase, immutable after activation
  name        String
  type        String?  // e.g. "hospital", "company", "government"
  timezone    String   @default("Asia/Bangkok")
  currency    String   @default("THB")
  active      Boolean  @default(true)
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/// LegacyReference — bridges canonical records back to their source legacy code/record.
/// Identity: organizationId + sourceApp + sourceEntity + legacyCode
/// So same legacy code from different orgs are NOT the same mapping.
model LegacyReference {
  id              String   @id @default(cuid())
  organizationId  String   @default("default")
  sourceApp       String   // itam | services | stock | other
  sourceSheet     String?
  sourceEntity    String   // Device | MasterItem | WorkOrder | StockItem | ...
  sourceRecordId  String?
  legacyCode      String
  legacyLabel     String?
  targetEntity    String   // Device | MasterItem | WorkOrder | StockItem | ...
  targetId        String
  targetCode      String?
  mappingStatus   String   @default("ACTIVE") // ACTIVE | MERGED | RETIRED | UNRESOLVED
  mappingNote     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, sourceApp, sourceEntity, legacyCode])
  @@index([targetEntity, targetId])
  @@index([organizationId, legacyCode])
  @@index([sourceApp, sourceSheet])
}

/// SetupRun — one execution of the onboarding wizard (resumable, idempotent).
model SetupRun {
  id             String       @id @default(cuid())
  organizationId String
  status         String       @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED | FAILED | CANCELLED
  currentStep    String?
  startedBy      String
  completedBy    String?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?
  errorMessage   String?
  // P1-04: optimistic concurrency for setup runs. Two admins updating the same
  // run concurrently is rejected via the `version` compare-and-swap in
  // PATCH /api/setup/runs/[id] (same pattern as WorkOrder.version / Device.version).
  version        Int       @default(1)
  steps          SetupStep[]
  @@index([organizationId, status])
  @@index([version])
}

/// SetupStep — one step in a SetupRun. Tracks inputHash for idempotent re-runs.
model SetupStep {
  id           String   @id @default(cuid())
  setupRunId   String
  stepKey      String   // preflight | organization | modules | code_pattern | sites | org_structure | master_data | admin | integration | review | activate
  status       String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | FAILED | SKIPPED
  inputHash    String?  // hash of input payload — skip re-apply if unchanged
  resultJson   Json?
  errorMessage String?
  completedBy  String?
  startedAt    DateTime?
  completedAt  DateTime?
  setupRun     SetupRun @relation(fields: [setupRunId], references: [id], onDelete: Cascade)
  @@unique([setupRunId, stepKey])
  @@index([status])
}

/// CustomFieldDefinition — org-scoped custom field schema for canonical entities.
/// Constraint: organizationId + targetEntity + key = unique
/// organizationId = 'default' or 'GLOBAL' for system template (must be copied, not edited by tenant)
model CustomFieldDefinition {
  id              String   @id @default(cuid())
  organizationId  String   @default("default")
  key             String   // snake_case or kebab-case, e.g. "asset_owner"
  label           String   // display label, e.g. "ผู้รับผิดชอบ"
  description     String?
  targetEntity    String   // Device | WorkOrder | StockItem | MasterItem
  fieldType       String   // text | textarea | integer | decimal | boolean | date | datetime | select | multiselect | email | url
  required        Boolean  @default(false)
  active          Boolean  @default(true)
  isSystem        Boolean  @default(false)
  sortOrder       Int      @default(0)
  section         String?
  placeholder     String?
  validationJson  Json?
  visibilityJson  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  options         CustomFieldOption[]
  values          CustomFieldValue[]

  @@unique([organizationId, targetEntity, key])
  @@index([organizationId, targetEntity, active])
}

/// CustomFieldOption — for select/multiselect field types.
model CustomFieldOption {
  id        String   @id @default(cuid())
  fieldId   String
  value     String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  field     CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, value])
  @@index([fieldId, active])
}

/// CustomFieldValue — stored value for a custom field on a target record.
/// Identity: organizationId + fieldId + targetEntity + targetId
/// valueJson is the canonical storage; valueText/valueNumber/valueDate are typed projections for indexed queries.
model CustomFieldValue {
  id              String   @id @default(cuid())
  organizationId  String   @default("default")
  fieldId         String
  targetEntity    String
  targetId        String
  valueJson       Json
  valueText       String?  // projection for text search
  valueNumber     Decimal? // projection for numeric queries
  valueDate       DateTime? // projection for date queries
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  field           CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fieldId, targetEntity, targetId])
  @@index([organizationId, targetEntity, targetId])
  @@index([fieldId, valueText])
}


// ============================================================
// 1) Device — อุปกรณ์ IT (เครื่องพิมพ์, สแกนเนอร์, คอมพิวเตอร์, ...)
// ============================================================
model Device {
  id              String   @id @default(cuid())
  assetCode       String   @unique // asset_no — เลขสินทรัพย์รวม ห้ามแก้ไข
  // ── Multi-org foundation (Phase 1) — nullable to allow legacy migration ──
  organizationId  String?  // tenant scope; null = legacy, will backfill to 'PILOT'
  legacyAssetCode String?  // asset_no from legacy system — never use as primary assetCode
  legacySourceApp String?  // itam | services | stock | other
  legacySourceKey String?  // deterministic source identity from legacy system
  name            String // ชื่ออุปกรณ์
  brand           String
  model           String
  type            String // ประเภท: PRINTER | SCANNER | COMPUTER | NETWORK | OTHER
  serialNumber    String? // serial
  status          String   @default("Active")
  site            String // สาขา/ที่ตั้ง
  department      String?
  departmentCode  String?
  parentRef       String?
  assetSiteCode   String? // asset_site_code — รหัสประจำ Site (SITE-NNNNN)
  displayLabel    String? // ป้ายแสดงผลที่ผู้ใช้กำหนดเอง (display label)
  location        String?
  building        String?
  floor           String?
  room            String?
  purchaseDate    String? // ISO date
  purchasePrice   Decimal?
  salvageValue    Decimal? @default(0)
  usefulLife      Int?
  warrantyMonths  Int      @default(12)
  warrantyEnd     String?
  vendor          String?
  contractNo      String?
  installDate     String?
  uninstallDate   String?
  meterRequired   Boolean  @default(false)
  meterMode       String? // TOTAL | BW_COLOR
  lastMeterBw     Int      @default(0)
  lastMeterColor  Int      @default(0)
  ip              String?
  mac             String?
  remoteId        String?
  currentAssignee String?
  remark          String?
  costCenter      String?
  deviceGroup     String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?  @default("System")

  // ── Asset Tag (Phase 2.6 — future RFID/NFC/BLE support) ──
  // Physical tag identifier for asset tracking beyond QR stickers.
  // Currently unused — field reserved so future hardware integration
  // (USB RFID reader, BLE beacons, NFC tags) doesn't need schema migration.
  // tagType defaults to QR (current system uses Smart QR URLs).
  tagId           String?
  tagType         String   @default("QR") // QR | BARCODE | NFC | RFID_UHF | BLE

  // ── Device Set / Parent-Child (Task ID 9, Phase 2) ──
  // Lets devices be grouped as a "set": e.g. a printer (parent) with
  // its UPS, network card, paper tray (children). Children may or may not
  // have their own assetCode (if not, use a generated placeholder).
  // `parentDeviceId` is a self-FK; onDelete: SetNull so deleting a parent
  // doesn't cascade-delete children (they become orphaned but kept).
  parentDeviceId String?
  parentDevice   Device?  @relation("DeviceSetChildren", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  childDevices   Device[] @relation("DeviceSetChildren")
  setLabel       String? // ชื่อชุด เช่น "ชุดเครื่องพิมพ์ห้องจ่ายยา"
  setPosition    Int? // ลำดับในชุด (1, 2, 3, …)

  // ── Device Replacement ──
  // When this device is replaced by a newer one, `replacedById` points
  // to the new device. Smart QR scan on the old device will then redirect
  // to the new one (so the sticker on the old physical box still works).
  // Self-FK; onDelete: SetNull so deleting the new device doesn't cascade.
  replacedById    String?
  replacedBy      Device?  @relation("DeviceReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replacedByFrom  Device[] @relation("DeviceReplacement")
  replacedAt      DateTime?

  // ── Phase 4.2: Soft-delete ──
  // Set by future soft-delete handlers instead of `db.device.delete()`.
  // Existing DELETE endpoints currently hard-delete — a follow-up task will
  // migrate them to set deletedAt = now() and filter reads by deletedAt IS NULL.
  // Kept optional so existing rows are unaffected.
  deletedAt       DateTime?
  version          Int      @default(1) // L-32: optimistic concurrency for sync

  // Relations (other models reference Device via deviceId)
  meterReadings     MeterReading[]
  transfers         DeviceTransfer[]
  assignments       Assignment[]
  maintenanceLogs   MaintenanceLog[]
  workOrders        WorkOrder[]
  stockTransactions StockTransaction[]
  pmSchedules       PMSchedule[]
  accessories       DeviceAccessory[]
  licenses          LicenseRecord[]   // PUBLIC-QR-PHASE-1-SCHEMA — real FK from LicenseRecord.deviceId

  @@index([parentDeviceId])
  @@index([status])
  @@index([site])
  @@index([serialNumber])
  @@index([replacedById])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
}

model MeterReading {
  id                      String   @id @default(cuid())
  organizationId          String?  // tenant scope (Phase 1 multi-org)
  readingId               String?  @unique
  deviceId                String
  assetCode               String? // asset_no — สำหรับ CSV import lookup
  readingDate             String // ISO date
  readingMonth            String? // YYYY-MM
  meterBw                 Int      @default(0)
  meterColor              Int      @default(0)
  pagesBw                 Int      @default(0)
  pagesColor              Int      @default(0)
  prevMeterBw             Int      @default(0)
  prevMeterColor          Int      @default(0)
  // Snapshot of Device.meterMode at the time of this reading (TOTAL | BW_COLOR | null).
  // Lets us reconstruct the meter configuration when the reading was taken, so
  // mode-switch detection works even after device.meterMode has changed.
  meterMode               String? // TOTAL | BW_COLOR
  // Snapshot of the previous reading's meterMode — makes mode transitions
  // explicit and queryable (e.g. "show me all TOTAL→BW_COLOR transitions").
  prevMeterMode           String?
  readingType             String? // MONTHLY | INITIAL | FINAL | RESET | CHECKOUT | SEND_REPAIR | RETURN | TRANSFER | TRANSFER_IN
  readBy                  String?
  remark                  String?
  locationAtReading       String?
  siteAtReading           String?
  buildingAtReading       String?
  floorAtReading          String?
  departmentAtReading     String?
  departmentCodeAtReading String?
  eventType               String?
  eventId                 String?
  isDemo                  Boolean  @default(false)
  createdAt               DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  // ── Phase 4.2: Soft-delete ──
  // Optional timestamp; when set, the reading is considered deleted but kept
  // for audit. Existing DELETE endpoints still hard-delete — a follow-up
  // task will migrate them to set deletedAt = now().
  deletedAt DateTime?
  @@index([deviceId])
  @@index([readingMonth])
  @@index([isDemo])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
  // Composite indexes for common query patterns
  @@index([deviceId, readingMonth])       // meter readings per device per month
  @@index([readingType, readingDate])     // filter by type + date range
  @@index([readingDate])                  // date range queries (dashboard)
  @@index([deviceId, readingDate])        // latest reading per device
}

// ============================================================
// 3) Cycle — รอบจดมิเตอร์
//    `site` is optional — null means "all sites" (a global cycle).
//    When set, the cycle is scoped to that site code (e.g. "UDH").
// ============================================================
model Cycle {
  id        String   @id @default(cuid())
  name      String
  startDate String
  endDate   String
  status    String   @default("active")
  site      String? // nullable — null = all sites (global cycle)
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  isDemo    Boolean  @default(false)
  @@index([status])
  @@index([site])
  @@index([updatedAt])
}

// ============================================================
// 4) DeviceTransfer — ประวัติการย้าย
// ============================================================
model DeviceTransfer {
  id                 String   @id @default(cuid())
  organizationId      String?  // tenant scope
  logId              String?  @unique
  deviceId           String
  isDemo           Boolean  @default(false)
  assetCode          String? // Asset_No
  moveDate           String?
  action             String? // TRANSFER | TRANSFER_SITE | STATUS_CHANGE | STATUS_AND_TRANSFER | TRANSFER_BY_LIFECYCLE
  fromStatus         String?
  toStatus           String?
  fromSite           String?
  fromAssetSiteCode  String?
  fromBuilding       String?
  fromFloor          String?
  fromDepartment     String?
  fromDepartmentCode String?
  fromLocation       String?
  toSite             String
  toAssetSiteCode    String?
  toBuilding         String?
  toFloor            String?
  toDepartment       String?
  toDepartmentCode   String?
  toLocation         String?
  meterReadingId     String?
  movedBy            String?
  remark             String?
  transferDate       String
  reason             String?
  createdAt          DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([deviceId])
  @@index([toSite])
}

// ============================================================
// 5) Assignment — การมอบหมายอุปกรณ์
// ============================================================
model Assignment {
  id                 String   @id @default(cuid())
  assignmentId       String?  @unique
  deviceId           String
  isDemo          Boolean  @default(false)
  assignee           String
  assigneeRole       String?
  department         String?
  checkoutDate       String
  expectedReturnDate String?
  actualReturnDate   String?
  status             String   @default("active")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([assignee])
}

// ============================================================
// 6) MaintenanceLog — ประวัติซ่อมบำรุง
// ============================================================
model MaintenanceLog {
  id           String   @id @default(cuid())
  logId        String?  @unique
  deviceId     String
  isDemo          Boolean  @default(false)
  type         String // repair | maintenance | inspection | upgrade
  status       String   @default("open")
  startDate    String
  endDate      String?
  cost         Decimal?
  vendor       String?
  description  String
  resolvedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
}

// ============================================================
// 7) WorkOrder — ใบงานแจ้งซ่อม
// ============================================================
model WorkOrder {
  id               String    @id @default(cuid())
  woNumber         String?   @unique
  // ── Multi-org foundation (Phase 1) ──
  organizationId   String?   // tenant scope for new work orders
  legacySourceApp  String?   // source app of legacyJobNo/requestId
  legacySourceKey  String?   // deterministic source identity
  // Legacy source identifier; immutable for traceability when supplied by imports.
  legacyJobNo      String?   @map("legacy_job_no")
  // New ITAM-NextJS identifier; woNumber remains as the compatibility display field.
  systemJobNo      String?   @unique @map("system_job_no")
  requestId        String?   @unique
  subject          String
  building         String?
  location         String?
  details          String?
  priority         String    @default("ปกติ")
  reporterName     String?
  reporterEmail    String?
  tel              String?
  employeeCode     String?
  submissionSource String    @default("guest")
  trackable        Boolean   @default(false)
  lineUserId       String?
  lineMessageId    String?   @unique
  printTemplateId  String?
  externalMeta     String?
  picBefore        String?
  picOnsite        String?
  picAfter         String?
  status           String    @default("PENDING")
  acceptStatus     String?
  assignedTo       String?
  assignedBy       String?
  assignedAt       DateTime?
  assignmentNote   String?
  detailsAdmin     String?
  dateAdmin        String?
  resolution       String?
  resolutionGroup  String?
  editUnlockActive Boolean   @default(false)
  editUnlockBy     String?
  editUnlockAt     DateTime?
  editUnlockNote   String?
  workCompletedAt  DateTime?
  closedAt         DateTime?
  canceledAt       DateTime?
  cancelReason     String?
  deviceId         String?
  isDemo           Boolean   @default(false)
  isSpecialFee     Boolean   @default(false) // งานพิเศษ (มีค่าใช้จ่าย) — แอปอื่นดึงผ่าน API
  // ── Site-based access control (Phase 0: transitional) ──
  // Direct Site reference so work orders without a device can still be
  // scoped. For work orders with a device, the server derives siteCode
  // from Device.site on create/update. Null = external/unassigned (uses
  // a separate authorization flow — never means "all sites").
  // See: Site-Based Access Control Guidance for ITAM-NextJS.md §5.1
  siteCode         String?
  // B4 FIX: Optimistic concurrency version field.
  // Incremented on every update. Callers can send `expectedVersion` in
  // PUT/PATCH to detect concurrent modification (409 Conflict).
  // Used with serializable transaction for device reassignment.
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ── Public QR Repair Submission ──
  // When a work order is submitted via public QR scan (no staff login),
  // `publicReporterId` links to the PublicReporter record (LINE-verified
  // or anonymous with phone). `submissionSource` is reused for the source
  // flag: 'guest' (default), 'line_liff', 'public_qr', 'app'.
  publicReporterId String?
  publicReporter   PublicReporter? @relation(fields: [publicReporterId], references: [id], onDelete: SetNull)

  device   Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  messages WorkOrderMessage[]
  reviews  WorkOrderReview[]
  images   WorkOrderImage[]
  parts    WorkOrderPart[]

  // ── Phase 4.2: Soft-delete ──
  // Optional timestamp; when set, the WO is considered deleted but kept for
  // audit. Existing DELETE endpoints still hard-delete — a follow-up task
  // will migrate them to set deletedAt = now().
  deletedAt DateTime?

  @@index([status])
  @@index([legacyJobNo])
  @@index([assignedTo])
  @@index([deviceId])
  @@index([isDemo])
  @@index([isSpecialFee])
  @@index([siteCode, status, createdAt])
  @@index([version])
  @@index([publicReporterId])
  @@index([deletedAt]) // Phase 4.2: soft-delete index
}

// ============================================================
// 8) WorkOrderMessage — แชทในใบงาน
// ============================================================
model WorkOrderMessage {
  id          String   @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  message     String
  author      String?
  authorRole  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([workOrderId])
}

// ============================================================
// 9) WorkOrderReview — คะแนนความพึงพอใจ
// ============================================================
model WorkOrderReview {
  id  String   @id @default(cuid())
  // @unique is load-bearing: the review route enforces "one review per work
  // order" with a findUnique-then-create check. Without a DB-level constraint
  // two concurrent submissions both pass the check and insert a duplicate
  // review. The previous bare @@index([workOrderId]) could not guarantee that.
  workOrderId String   @unique
  isDemo      Boolean  @default(false)
  // SPRINT-4 #2 (AUDIT-DB-RUNTIME S-P1-18): rating constrained 1-5.
  // SQLite doesn't enforce CHECK constraints via Prisma, so the API
  // layer (review route) also validates. Adding @db.Int + comment for
  // documentation. For PostgreSQL, add a CHECK constraint manually:
  //   ALTER TABLE "WorkOrderReview" ADD CONSTRAINT rating_range
  //   CHECK (rating >= 1 AND rating <= 5);
  rating      Int      /// 1-5 stars (enforced in API route + DB CHECK on PostgreSQL)
  comment     String?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
}

// ============================================================
// 10) WorkOrderImage — รูปภาพในใบงาน (หลายรูปต่อขั้นตอน)
// ============================================================
model WorkOrderImage {
  id          String   @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  stage       String // before | onsite | after
  image_data  String
  // SPRINT-1 #2: when storage abstraction (R2/Blob/Supabase) is configured,
  // images are uploaded to external storage and only the URL is stored in
  // `imageUrl` (with `storageProvider` for audit). `image_data` is kept for
  // backward-compat with legacy rows + dev mode where storage='memory'
  // returns a data URL. For new uploads with external storage, `image_data`
  // is set to '' (empty) to avoid DB bloat.
  imageUrl          String?
  storageProvider   String?
  sizeBytes         Int?
  fileName    String?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  updatedAt DateTime? @updatedAt
  @@index([workOrderId])
  @@index([stage])
  @@map("work_order_images")
}

// ============================================================
// 10b) WorkOrderPart — คำขออะไหล่ในใบงาน (Task ID: P0-SCHEMA-FIXES)
//     Referenced by CompleteDialog Step 2 (work-orders-page.tsx).
//     Tracks each part requested against a WorkOrder, with optional
//     StockItem linkage and an approval workflow (PENDING -> APPROVED/REJECTED).
// ============================================================
model WorkOrderPart {
  id          String     @id @default(cuid())
  workOrderId String
  isDemo      Boolean  @default(false)
  workOrder   WorkOrder  @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  productCode String
  productName String
  quantity    Int
  unitCost    Decimal?
  totalCost   Decimal?
  status      String     @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy String?
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([workOrderId])
  @@index([status])
  @@index([stockItemId])
}

// ============================================================
// 11) LicenseRecord — ลิขสิทธิ์ซอฟต์แวร์
// ============================================================
model LicenseRecord {
  id          String   @id @default(cuid())
  License_ID  String?
  Asset_No    String? // links to Device.assetCode (legacy — kept for back-compat)
  Software    String
  LicenseType String? // OEM | Volume | Retail | Subscription | Open License
  License_Key String?
  Quantity    Int      @default(1)
  Expiry_Date String?
  Remark      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── PUBLIC-QR-PHASE-1-SCHEMA: real FK to Device (replaces legacy Asset_No
  //     string lookup). Nullable so the migration script can backfill
  //     existing rows in place (see scripts/migrate-license-device-id.ts).
  //     onDelete: SetNull so deleting a Device keeps the license record
  //     (audit trail) instead of cascading the delete.
  deviceId    String?
  device      Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  // ── PUBLIC-QR-PHASE-1-SCHEMA: active flag — when a device is replaced and
  //     moveLicenses=false, the licenses on the old device get deactivated
  //     (isActive=false) instead of being deleted, preserving the audit
  //     trail of "this license was issued for that device".
  isActive    Boolean  @default(true)

  isDemo    Boolean  @default(false)
  @@index([Asset_No])
  @@index([deviceId])
  @@index([isActive])
  @@index([isDemo])
  @@map("license_records")
}

// ============================================================
// 12) SiteAttribute — ข้อมูลสาขา + อัตราค่ากระดาษ
//     Source: sheet "Site_Attributes"
// ============================================================
model SiteAttribute {
  id             String   @id @default(cuid())
  organizationId  String?  // tenant scope
  SiteCode       String   @unique // เช่น UDH, NKP, MECUD, PPIT
  SiteName       String? // เช่น โรงพยาบาลศูนย์อุดรธานี
  LineOA         String? // LINE OA ID/Token
  Hotline        String? // เบอร์ติดต่อ
  PaperRateBW    Decimal? @default(0.5) // ฿/แผ่น ขาวดำ
  PaperRateColor Decimal? @default(2.0) // ฿/แผ่น สี
  TelegramChatId String?  @map("TelegramChatId") // Telegram chat ID สำหรับสาขา
  EmailAddress   String?  @map("EmailAddress") // อีเมลสาขาสำหรับรับแจ้งเตือน

  // ── LINE Login (public QR scan → repair flow) ──
  // PPIT (single org) uses ONE shared LINE Login Channel. But each site
  // has its OWN LINE OA (for friend add + notifications). When a public
  // reporter logs in via LINE Login, we auto-friend them to the site's
  // LINE OA so they can receive status updates via that OA.
  // LiffId is optional — used only if we deploy as a LIFF app (in-LINE).
  LiffId                 String?  @map("LiffId")
  LiffAutoFriendLine     String?  @map("LiffAutoFriendLine") // LINE OA handle to auto-friend on login
  // Public repair rate-limit per site (per phone/day, per IP/day)
  PublicRepairDailyLimit Int     @default(3) // max WO/phone/day
  PublicRepairIpDailyLimit Int    @default(10) // max WO/IP/day

  isDemo         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  publicReporters PublicReporter[]

  @@map("site_attributes")
  @@index([isDemo])
}

// ============================================================
// 13) Site — สาขา (legacy, ใช้คู่กับ SiteAttribute)
// ============================================================
model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
