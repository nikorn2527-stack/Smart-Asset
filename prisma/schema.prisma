// ============================================================
// 14) SiteRate — อัตราค่ากระดาษต่อสาขา (legacy)
// ============================================================
model SiteRate {
  id        String   @id @default(cuid())
  siteCode  String
  bwRate    Decimal @default(0.5)
  colorRate Decimal @default(2.0)
  createdAt DateTime @default(now())
