{
  "name": "smart-asset",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=1536 node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "typecheck:full": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit --incremental false",
    "postinstall": "node scripts/set-prisma-provider.mjs && prisma generate || echo 'prisma generate failed (may be in CI without DATABASE_URL)'",
    "prebuild": "node scripts/set-prisma-provider.mjs",
    "db:push": "prisma db push",
    "db:use": "node scripts/use-db.mjs",
    "db:use:pg": "node scripts/use-db.mjs pg && node scripts/set-prisma-provider.mjs && prisma generate",
    "db:use:sqlite": "node scripts/use-db.mjs sqlite && node scripts/set-prisma-provider.mjs && prisma generate",
    "db:pg:up": "docker compose up -d db && node scripts/use-db.mjs pg && node scripts/set-prisma-provider.mjs && prisma generate && prisma db push",
    "db:pg:down": "docker compose stop db",
    "db:push:seed": "prisma db push && bun run db:seed",
    "db:push:danger": "echo WARNING: This will destroy data. Use prisma migrate deploy for production.",
    "db:seed": "bun scripts/seed-all.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve": "prisma migrate resolve",
    "db:reset": "prisma migrate reset",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:auth": "npx tsx tests/auth/authorization-matrix.test.ts",
    "test:integration": "npx tsx tests/auth/route-integration.test.ts",
    "test:concurrency": "npx tsx tests/auth/concurrency.test.ts",
    "test:all": "bun run test:auth && bun run test:integration && bun run test:concurrency",
    "test:sync": "vitest run tests/sync/",
    "check:modules": "node scripts/check-module-manifest.mjs",
    "db:backup": "bun scripts/backup-db.ts",
    "db:restore": "bun scripts/restore-db.ts",
    "db:safe-migrate": "bash scripts/safe-migrate.sh",
    "db:safe-push": "bash scripts/safe-migrate.sh --push",
    "db:safe-migrate:prod": "bash scripts/safe-migrate.sh --production",
    "check:drift": "bun scripts/check-schema-drift.ts",
    "check:module-gating": "node scripts/check-module-gating.mjs",
    "check:i18n": "bun run scripts/check-i18n.ts",
    "check:i18n:strict": "bun run scripts/check-i18n.ts --strict-literals",
    "test:cross-org": "bun run tests/runtime/cross-org-isolation.test.ts",
    "test:backup-restore": "bun run tests/runtime/backup-restore.test.ts",
    "test:failure": "bun run tests/runtime/failure-scenarios.test.ts",
    "verify:backup": "bun run scripts/verify-backup-restore.ts",
    "test:runtime": "bun run test:cross-org && bun run test:backup-restore && bun run test:failure",
    "reset:passwords": "bun run scripts/reset-all-passwords.ts",
    "test:local-first": "bash scripts/test-local-first.sh",
    "cron:sync": "bun run scripts/cron-sync.ts",
    "cron:backup": "bun run scripts/verify-backup-restore.ts",
    "audit:visual": "bun run scripts/visual-consistency-audit.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.1.1",
    "@mdxeditor/editor": "^3.39.1",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@reactuses/core": "^6.0.5",
    "@sentry/nextjs": "^10.73.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.82.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/edge-config": "^1.5.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^7.0.2",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.2",
    "google-auth-library": "^11.0.2",
    "google-spreadsheet": "^5.3.0",
    "googleapis": "^176.0.0",
    "input-otp": "^1.4.2",
    "jose": "^6.2.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "prisma": "6.19.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-day-picker": "^9.8.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "recharts": "^2.15.4",
    "resend": "^6.25.0",
    "sharp": "^0.34.3",
    "socket.io-client": "^4.7.5",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.5",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
