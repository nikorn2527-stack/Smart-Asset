# Smart-Asset Railway deployment environment variables
# Copy this file to .env and adjust values for your environment.
# Note: .env is gitignored and should NOT be committed to version control.

# Database path (use /data/ on Railway with a persistent volume)
ASSET_DB_PATH=/data/govasset.sqlite3

# Server port (Railway assigns PORT automatically; 8080 is the Dockerfile default)
PORT=8080

# Server host
HOST=0.0.0.0

# Repair approval threshold in THB (demo only)
REPAIR_APPROVAL_THRESHOLD=5000

# Timezone
TZ=Asia/Bangkok

# Python unbuffered output for container logs
PYTHONUNBUFFERED=1

# JWT secret (change this in production!)
JWT_SECRET=your-secret-key-change-in-production

# Public base URL for QR codes and receipts (set to your Railway app URL)
PUBLIC_BASE_URL=https://your-app.railway.app