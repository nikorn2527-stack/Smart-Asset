{
  "buildCommand": "rm -rf .next && node scripts/set-prisma-provider.mjs && npx prisma generate && next build --webpack",
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "crons": [
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/sync-legacy",
      "schedule": "0 2 * * 1"
    }
  ],
  "regions": ["sin1"],
  "framework": "nextjs",
  "github": {
    "silent": true
  }
}
