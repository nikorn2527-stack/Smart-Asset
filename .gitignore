db/custom.db
db/*.db
.vercel
.env*

# Credentials — NEVER commit real secrets to Git
google-service-account.json
*.pem
*.key
backups/
*.tsbuildinfo

# Build artifacts
tsconfig.tsbuildinfo

# Compiled Go service binary (9 MB, Linux-only, rebuild with `go build`).
# The source (main.go, go.mod, go.sum) IS tracked - only the output is not.
/mini-services/go-sync-service/go-sync-service
# Catch any future `go build` output from any Go package in this repo.
mini-services/**/go-sync-service
*.exe

# Backup files (should be in external storage, not git)
backups/

# Development handoff context (not needed in production)
agent-ctx/

# PR/G2 evidence (not needed in production)
g2-evidence/
docs/evidence/
docs/g2-evidence/

# Package manager lockfile (using bun, not npm)
package-lock.json
upload/

# transient verification scripts (agent scratch)
.v.ps1

# dev-server output captured during local smoke testing
.dev.log
.dev.err

# generated output dump (screenshots, exports) - not source
download/*.png

# runtime PID file written by .zscripts/dev.sh
.zscripts/dev.pid

# local agent tooling, not application code
.continue/

# Preserved Python prototype runtime files
legacy/**/__pycache__/
legacy/**/*.sqlite3
legacy/**/*.sqlite3-*
